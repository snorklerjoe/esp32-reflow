# Copy this file to .env and set your own values. .env is git-ignored.
# These are compiled into the firmware; rebuild + reflash after changing them.

# Password for the web app (everything except Settings / applying PID gains).
WEB_PASSWORD=changeme

# Admin password: unlocks Settings (GPIO pins, PID gains, limits).
# Logging in with this password directly also grants admin.
ADMIN_PASSWORD=change-me-too

# Name of the open Wi-Fi access point (optional).
AP_SSID=ReflowOven
